{
  "name": "sobres-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc -p tsconfig.json --noEmit && vite build && node scripts/check-bundle.mjs && node scripts/check-content.mjs",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:content": "node scripts/check-content.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "gsap": "^3.12.7",
    "lenis": "^1.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
